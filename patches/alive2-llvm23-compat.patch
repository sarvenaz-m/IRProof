diff --git a/CMakeLists.txt b/CMakeLists.txt
index 64a341d..2d57160 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -48,10 +48,16 @@ if (CYGWIN)
 endif()
 
 find_package(Git REQUIRED)
+set(ALIVE_VERSION_OVERRIDE "" CACHE STRING "Version label for source archives")
+if (ALIVE_VERSION_OVERRIDE)
+  set(ALIVE_VERSION_COMMAND "${CMAKE_COMMAND}" -E echo "${ALIVE_VERSION_OVERRIDE}")
+else()
+  set(ALIVE_VERSION_COMMAND "${GIT_EXECUTABLE}" describe --tags --dirty --always)
+endif()
 add_custom_command(
   OUTPUT "${PROJECT_BINARY_DIR}/version_gen.h.tmp"
   COMMAND "${CMAKE_COMMAND}" -E echo_append "#define ALIVE_VERSION_MACRO " > "${PROJECT_BINARY_DIR}/version_gen.h.tmp"
-  COMMAND "${GIT_EXECUTABLE}" describe --tags --dirty --always >> "${PROJECT_BINARY_DIR}/version_gen.h.tmp"
+  COMMAND ${ALIVE_VERSION_COMMAND} >> "${PROJECT_BINARY_DIR}/version_gen.h.tmp"
   WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
   VERBATIM
 )
@@ -173,6 +179,8 @@ endif()
 if (BUILD_LLVM_UTILS OR BUILD_TV)
   cmake_policy(SET CMP0075 NEW)
   find_package(LLVM REQUIRED CONFIG)
+  # Use one Z3 runtime; avoid an LLVM shared-library dependency on another Z3.
+  set(LLVM_LINK_LLVM_DYLIB OFF)
 
   message(STATUS "Found LLVM ${LLVM_PACKAGE_VERSION}")
   message(STATUS "CMAKE_PREFIX_PATH: ${CMAKE_PREFIX_PATH}")
